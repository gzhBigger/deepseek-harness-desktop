node_modules/
dist/
src-tauri/target/
.env
.env.*
!.env.example
# Tauri updater private signing key: keep only the public key in Git.
src-tauri/keys/*.key
!src-tauri/keys/*.key.pub

# Electron P0 shell: local build and smoke-test artifacts
electron/*.log
electron/release/
electron/runtime/
electron/.runtime-build/
electron/release-debug/

# Electron 壳的 minisign 私钥（唯一副本另存于 %USERPROFILE%\.dsh-desktop-keys）
electron/keys/*.key
!electron/keys/*.key.pub

# 上游 dshmarket 源码/目录的临时参考副本（只用于核对分类与筛选做法，不入库）
.tmp-dshmarket/
# 本机性能排查/发版过程的临时产物与日志（分析报告、探针脚本、构建日志）
.tmp-perf/

# Android client (android/): build output, machine-specific SDK path, and the signing key.
android/local.properties
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/app/release/
android/keys/
*.jks
*.keystore

# The pinned tunnel binary is fetched by scripts/prepare-cloudflared.mjs, not committed.
electron/resources/cloudflared/

# The plugins the shell injects are produced by scripts/prepare-plugins.mjs from the plugins
# workspace; committing compiled copies would fork them from their source.
electron/resources/plugins/

electron/pnpm-workspace.yaml
