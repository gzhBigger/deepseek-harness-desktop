{
  "name": "dsh-desktop-electron",
  "productName": "DSH Desktop",
  "version": "0.4.18",
  "private": true,
  "description": "Electron shell for DSH Desktop (the Tauri shell has been retired)",
  "license": "MIT",
  "author": {
    "name": "DSH Desktop contributors"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "install-electron",
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "minisign:check": "node scripts/minisign-roundtrip.mjs 8",
    "package:win": "node scripts/prepare-runtime.mjs && node scripts/prepare-cloudflared.mjs && node scripts/prepare-plugins.mjs && node build.mjs && electron-builder --win nsis --publish never --config electron-builder.config.mjs && node scripts/verify-package.mjs",
    "package:dir": "node scripts/prepare-runtime.mjs && node scripts/prepare-cloudflared.mjs && node scripts/prepare-plugins.mjs && node build.mjs && electron-builder --win --dir --publish never --config electron-builder.config.mjs && node scripts/verify-package.mjs",
    "release:dry": "node scripts/release-electron.mjs --dry-run",
    "release": "node scripts/release-electron.mjs",
    "smoke": "node build.mjs && node scripts/smoke.mjs cookie",
    "smoke:token": "node build.mjs && node scripts/smoke.mjs token",
    "smoke:proxy": "node build.mjs && node scripts/smoke.mjs proxy",
    "smoke:pocket": "node build.mjs && node scripts/smoke-pocket.mjs",
    "preview:market": "node scripts/preview-market.mjs",
    "preview:settings": "node scripts/preview-settings.mjs",
    "preview:pocket": "node scripts/preview-pocket.mjs",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "cloudflared:prepare": "node scripts/prepare-cloudflared.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "package:debug": "node scripts/prepare-plugins.mjs && node scripts/package-debug.mjs",
    "package:debug:dir": "node scripts/prepare-plugins.mjs && node scripts/package-debug.mjs --dir",
    "plugins:prepare": "node scripts/prepare-plugins.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.20.0",
    "electron": "44.10.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "smol-toml": "^1.9.1",
    "typescript": "~5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "yaml": "2.9.1"
  }
}
